<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:RoutineHelper.ViewModels"
             x:Class="RoutineHelper.Views.MainPage"
             x:DataType="viewModels:MainViewModel"
             Title="Routine Helper">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label Text="Routine Helper"
                   FontSize="28"
                   FontAttributes="Bold"/>

            <Label Text="Add your routine and get a reminder 10 minutes before it starts."
                   FontSize="14" />

            <Entry Placeholder="Routine name"
                   Text="{Binding RoutineTitle}" />

            <HorizontalStackLayout Spacing="12">
                <Label Text="Routine time" VerticalOptions="Center"/>
                <TimePicker Time="{Binding SelectedTime}" />
            </HorizontalStackLayout>

            <Button Text="Add routine"
                    Command="{Binding AddRoutineCommand}" />

            <Label Text="{Binding StatusMessage}"
                   TextColor="DarkGreen"
                   FontAttributes="Italic" />

            <Label Text="Your routines"
                   FontSize="20"
                   FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding Routines}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12" ColumnDefinitions="*,Auto">
                            <Label Text="{Binding Title}" FontSize="16" />
                            <Label Grid.Column="1"
                                   Text="{Binding DisplayTime}"
                                   FontAttributes="Bold" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
